# Copy to .env. Every FACEPASS_* setting and its default is in src/facepass/core/config.py.

# Password for the Postgres container in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Encrypts webhook secrets at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FACEPASS_SECRET_KEY=change-me-to-at-least-32-random-characters

# Used when running outside Docker. Compose sets its own value.
FACEPASS_DATABASE_URL=postgresql+psycopg://facepass:change-me@127.0.0.1:5436/facepass

# development | test | production. Production requires https webhook URLs.
FACEPASS_ENVIRONMENT=development

# JSON list of browser origins allowed to call the session upload endpoint.
FACEPASS_CORS_ORIGINS=["http://localhost:3000"]
